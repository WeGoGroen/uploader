# Omgevingsvariabelen van de uploader.
#
# Kopieer naar .env.local voor lokaal werk; zet dezelfde namen in Vercel onder
# Settings → Environment Variables. Waarden hieronder zijn voorbeelden, nooit
# echte sleutels. Alles onder "Verplicht" moet in productie gevuld zijn.

# ---------------------------------------------------------------------------
# Verplicht
# ---------------------------------------------------------------------------

# Ondertekent de inlogsessies. Minstens 32 willekeurige tekens, bv.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Ontbreekt deze, dan valt de app terug op een vaste sleutel die in de code
# staat, en kan iedereen een geldige (beheerders)sessie maken.
SESSION_SECRET=

# Redis (Vercel Marketplace). Bewaart tokens, statussen, concepten en de
# pogingslimiet bij het inloggen. Ook KV_URL of een naam die op REDIS_URL
# eindigt wordt herkend. Zonder Redis is er geen pogingslimiet op de inlogcode.
REDIS_URL=

# Geheim waarmee Vercel Cron de achtergrondtaken aanroept (ochtendcontrole,
# herinneringen, herstelwerker). Vercel zet het als Bearer-header mee.
CRON_SECRET=

# Dropbox-app (App Console). Het refresh-token komt normaal in Redis via de
# knop "Inloggen met Dropbox" op de Koppelingen-pagina; deze variabele is de
# terugval zonder Redis.
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REFRESH_TOKEN=

# ClickUp: het token van de eigenaar en de lijst waarin taken komen.
CLICKUP_TOKEN=
CLICKUP_LIST_ID=

# Dienst-token voor het Business Control Center (de /api/intern-routes).
# Minstens 24 tekens; beide kanten moeten hetzelfde token hebben.
CONTROL_CENTER_TOKEN=
CONTROL_CENTER_URL=https://wegogroen-control.vercel.app

# ---------------------------------------------------------------------------
# Koppelingen (nodig voor het onderdeel dat ze gebruikt)
# ---------------------------------------------------------------------------

# ClickUp-webhook (taak op klaar → SharePoint-overdracht). Het geheim komt uit
# scripts/create-clickup-webhook.mjs. Statussen die als "klaar" tellen,
# kommagescheiden.
CLICKUP_WEBHOOK_SECRET=
CLICKUP_DONE_STATUSES=
# Meerdere ClickUp-accounts als JSON-lijst; normaal staan ze in Redis.
CLICKUP_ACCOUNTS=

# Google Agenda (afspraken van vandaag op het dashboard).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Street View- en luchtfoto's in nieuwe projectmappen.
GOOGLE_MAPS_API_KEY=

# Microsoft Graph / SharePoint (overdracht van opgeleverde bestanden).
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SHAREPOINT_SITE_URL=
SHAREPOINT_ROOT_PATH=
# Submap in de projectmap waar SharePoint-bestanden landen (standaard "SharePoint").
SHAREPOINT_TARGET_SUBFOLDER=

# Mediatask (orders, puntenwolken, foto's).
MEDIATASK_API_BASE=
MEDIATASK_API_TOKEN=

# Kadaster: BAG-rapport en 3D BAG-rapport in de BAG-map van een energielabel.
KADASTER_BAG_API_KEY=
KADASTER_PRINT_API_KEY=

# Resend: uitgaande mail (herinneringen, storingsmelding) en de inkomende
# mail van RVO met het afschrift van een geregistreerd energielabel.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM=WeGoGroen <noreply@example.nl>
# Ontvangers van de ochtendcontrole bij een storing, kommagescheiden.
ALERT_EMAIL=

# Scan-controle met Claude op de NEN2580-documentenpagina.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Optioneel
# ---------------------------------------------------------------------------

# Links in mails naar de uploader en het control center.
NEXT_PUBLIC_SITE_URL=https://energielabel-app.vercel.app
NEXT_PUBLIC_BCC_URL=https://wegogroen-control.vercel.app

# APP_PASSWORD (het gedeelde wachtwoord van vóór de persoonlijke inlogcodes)
# wordt niet meer gebruikt en kan uit Vercel weg.

# Alleen voor lokale tests: paden naar voorbeeldbestanden (.dp en puntenwolk).
# Zonder deze worden de betreffende tests overgeslagen.
DP_SAMPLE=
PC_SAMPLE=
